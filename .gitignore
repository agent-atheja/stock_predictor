# Secrets — never commit
secrets/.env
secrets/access_token.txt

# Data lake (regenerable) & artifacts
datalake/bronze/
datalake/silver/
datalake/gold/
models/registry/*.txt
models/registry/*.joblib
models/registry/*.json
logs/

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Regenerable caches (instruments dump, wayback snapshots)
datalake/cache/

# Pre-cutover model registry snapshots — rollback points, not source.
# Same reasoning as models/registry/: model binaries do not belong in git.
models/registry_baseline_*/
