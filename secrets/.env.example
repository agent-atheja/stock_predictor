# Copy to secrets/.env and fill in. secrets/.env is git-ignored — never commit real keys.
# Self-contained: this project reads ONLY from here, no external project paths.

KITE_API_KEY=your_kite_api_key_here
KITE_API_SECRET=your_kite_api_secret_here

# Optional: pre-seeded request token from the Kite login redirect (see kite_client.py login)
# KITE_REQUEST_TOKEN=
